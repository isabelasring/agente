PORT=3001

# Carpeta local con todos los documentos (recursivo). Relativa al backend o absoluta.
# Ejemplo carpeta Proyectos sincronizada:
# GEOTRENDS_DOCUMENTS_ROOT=data/cursos/geo-basico/GEOTRENDS S.A.S/GeoTrends S.A.S - Proyectos
GEOTRENDS_DOCUMENTS_ROOT=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face Inference Providers (token con "Make calls to Inference Providers")
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Sin sufijo se anade :fastest (router). Modelos tipo SmolLM2 suelen fallar con :hf-inference en chat.
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-1B-Instruct

# Ollama (servicio local, por defecto http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (https://platform.deepseek.com/api_keys) — API compatible OpenAI; billing por uso
DEEPSEEK_API_KEY=
# Opcional: por defecto https://api.deepseek.com/chat/completions
# DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
