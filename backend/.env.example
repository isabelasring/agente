PORT=3001

# Carpeta local con todos los documentos (recursivo). Relativa al backend o absoluta.
# Cada subcarpeta directa dentro de data/ aparece como "Biblioteca" en la UI (ej. data/ESTANDARES, data/MI_CARPETA).
GEOTRENDS_DOCUMENTS_ROOT=data

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Opcional: max caracteres del texto del documento activo enviados a Groq (evita HTTP 413). Por defecto 18000; si aun falla, prueba 12000.
# GROQ_MAX_DOCUMENT_CHARS=18000

# Hugging Face Inference Providers (token con "Make calls to Inference Providers")
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Sin sufijo se anade :fastest (router). Modelos tipo SmolLM2 suelen fallar con :hf-inference en chat.
# Llama-3.2-1B suele alucinar y sugerir titulos en lugar de leerlos: para demos usa uno mas grande:
#   meta-llama/Llama-3.1-8B-Instruct   (recomendado, sigue prompts bien)
#   Qwen/Qwen2.5-7B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-1B-Instruct

# Ollama (servicio local, por defecto http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (https://platform.deepseek.com/api_keys) — API compatible OpenAI; billing por uso
DEEPSEEK_API_KEY=
# Opcional: por defecto https://api.deepseek.com/chat/completions
# DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-v4-flash
